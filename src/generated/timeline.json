{"fps":30,"total":1803,"scenes":[{"script":"曹操能平定北方，靠的不只是刀枪，还有一笔看不见的天使投资。","type":"map","from":0,"dur":158,"audio":"voice/82f4fbcf2ece.mp3","charFrames":[4.75,10.53,16.94,20.38,24.13,28.19,34.44,40.69,46,51.94,54.44,57.41,60.37,63.5,69.75,76,86.62,89.44,92.56,95.69,101,106.63,109.75,112.87,116,120.37,125.06,130.69,136.31,136.31],"speechEnd":136.31,"subs":[{"text":"曹操能平定北方，","from":3,"to":44},{"text":"靠的不只是刀枪，","from":44,"to":85},{"text":"还有一笔看不见的天使投资。","from":85,"to":158}]},{"script":"今天咱们聊聊，三国第一大股东：颍川士族。","type":"title","from":158,"dur":110,"audio":"voice/83fbfc1295ba.mp3","charFrames":[4.75,9.12,14.12,16.16,18.5,23.81,29.12,36.62,42.56,48.81,51.47,54.44,58.81,64.59,70.37,77.25,82.56,88.19,94.28,100.37,100.37],"speechEnd":100.37,"subs":[{"text":"今天咱们聊聊，","from":3,"to":35},{"text":"三国第一大股东：","from":35,"to":75},{"text":"颍川士族。","from":75,"to":110}]},{"script":"东汉的颍川郡，就是当时的人才交易所。荀、陈、钟、韩四大家族世代读书做官，号称颍川四长，门生故吏遍布朝廷。","type":"map","from":268,"dur":311,"audio":"voice/19f1447b2109.mp3","charFrames":[4.75,10.22,15.69,18.19,24.23,30.27,36.31,43.81,47.56,50.06,54.59,59.12,62.25,66,70.06,74.65,79.23,83.81,97.94,110.75,116.69,122.94,130.12,139.19,150.44,157,162.47,167.94,173.41,181.69,187.16,193.25,197.16,201.37,206.53,211.69,219.5,225.91,232.94,237.78,242.94,247.63,252.94,259.19,264.66,270.12,275.59,281.69,285.44,289.5,295.59,301.69,301.69],"speechEnd":301.69,"subs":[{"text":"东汉的颍川郡，","from":3,"to":42},{"text":"就是当时的人才交易所。","from":42,"to":96},{"text":"荀、陈、钟、韩四大家族世代读书做官，","from":96,"to":218},{"text":"号称颍川四长，","from":218,"to":257},{"text":"门生故吏遍布朝廷。","from":257,"to":311}]},{"script":"公元191年，荀彧看透了袁绍，转身投奔还只是东郡太守的曹操。","type":"map","from":579,"dur":161,"audio":"voice/3c4770c947f6.mp3","charFrames":[4.75,8.97,13.81,18.92,24.02,29.12,36.62,44.75,49.12,54.13,57.88,61.63,63.5,68.97,74.44,84.13,89.44,95.06,100.84,109.44,115.37,117.72,120.69,125.06,129.75,133.66,137.56,139.44,145.69,151.94,151.94],"speechEnd":151.94,"subs":[{"text":"公元191年，","from":3,"to":43},{"text":"荀彧看透了袁绍，","from":43,"to":82},{"text":"转身投奔还只是东郡太守的曹操。","from":82,"to":161}]},{"script":"曹操大喜过望：吾之子房也！这是我的张良啊。","type":"map","from":740,"dur":134,"audio":"voice/b315ff1956d6.mp3","charFrames":[4.75,10.37,16.63,22.02,27.41,32.8,38.19,48.19,56,61.31,66,72.56,78.5,92.31,97,99.5,101.38,103.25,108.88,114.5,124.5,124.5],"speechEnd":124.5,"subs":[{"text":"曹操大喜过望：","from":3,"to":46},{"text":"吾之子房也！","from":46,"to":90},{"text":"这是我的张良啊。","from":90,"to":134}]},{"script":"可荀彧带来的不只是他自己，而是一整套班底：郭嘉出谋划策，钟繇镇守关中，陈群制定法度。","type":"map","from":874,"dur":239,"audio":"voice/eec8ed90faff.mp3","charFrames":[4.75,9.44,13.5,17.87,21.31,24.75,34.44,38.19,42.25,45.69,50.06,54.91,59.75,70.06,74.28,79.12,83.19,87.72,92.56,97.72,102.88,113.19,117.88,123.19,128.27,133.34,138.42,143.5,149.44,154.44,159.44,164.44,168.97,173.5,179.75,184.44,191.62,199.44,203.03,206.94,212.09,217.25,217.25],"speechEnd":217.25,"subs":[{"text":"可荀彧带来的不只是他自己，","from":3,"to":68},{"text":"而是一整套班底：","from":68,"to":111},{"text":"郭嘉出谋划策，","from":111,"to":147},{"text":"钟繇镇守关中，","from":147,"to":182},{"text":"陈群制定法度。","from":182,"to":239}]},{"script":"公元196年，曹操迎汉献帝到许县，改名许都。颍川士族坐镇尚书台，替他管起了整个朝廷。","type":"map","from":1113,"dur":246,"audio":"voice/fe4f6e5a3ae3.mp3","charFrames":[4.75,10.22,16.31,21.94,27.56,33.19,41.31,49.44,55.37,61.94,66,70.9,75.79,81.31,84.75,90.37,96,101.31,105.22,109.44,114.91,120.37,134.5,140.44,146.69,153.72,163.56,169.19,175.12,180.13,186.53,192.94,201.37,205.44,208.56,214.5,217.94,220.44,223.41,226.69,231.84,237,237],"speechEnd":237,"subs":[{"text":"公元196年，","from":3,"to":47},{"text":"曹操迎汉献帝到许县，","from":47,"to":99},{"text":"改名许都。","from":99,"to":132},{"text":"颍川士族坐镇尚书台，","from":132,"to":199},{"text":"替他管起了整个朝廷。","from":199,"to":246}]},{"script":"曹操握着枪杆子，士族握着笔杆子，谁也离不开谁。","type":"balance","from":1359,"dur":120,"audio":"voice/c775a7986f34.mp3","charFrames":[4.75,10.37,16.63,19.75,22.25,28.29,34.33,40.37,47.25,53.34,60.06,63.5,65.69,68.19,73.34,78.5,84.44,92.25,95.06,97.87,100.69,103.5,111,111],"speechEnd":111,"subs":[{"text":"曹操握着枪杆子，","from":3,"to":45},{"text":"士族握着笔杆子，","from":45,"to":82},{"text":"谁也离不开谁。","from":82,"to":120}]},{"script":"靠着这套班底，曹操官渡击败袁绍，一路拿下了整个北方。","type":"map","from":1479,"dur":139,"audio":"voice/e863dbc4b020.mp3","charFrames":[4.75,10.06,12.25,15.06,18.81,25.37,31.94,38.81,44.12,49.75,54.28,59.44,63.19,67.25,73.34,79.44,87.25,91,95.06,98.66,102.25,104.44,107.56,111,116,121,121],"speechEnd":121,"subs":[{"text":"靠着这套班底，","from":3,"to":37},{"text":"曹操官渡击败袁绍，","from":37,"to":85},{"text":"一路拿下了整个北方。","from":85,"to":139}]},{"script":"可生意做大了，股东之间迟早要算账。咱们下期接着聊。","type":"map","from":1618,"dur":185,"audio":"voice/80238b0fb413.mp3","charFrames":[4.75,8.81,11.94,15.37,18.81,24.75,30.69,39.13,43.34,47.87,52.25,57.25,62.41,67.87,70.37,75.06,79.75,93.56,96.69,100.12,104.97,110.44,113.56,116.69,124.5,124.5],"speechEnd":124.5,"subs":[{"text":"可生意做大了，","from":3,"to":37},{"text":"股东之间迟早要算账。","from":37,"to":92},{"text":"咱们下期接着聊。","from":92,"to":185}]}]}